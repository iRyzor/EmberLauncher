{
  "name": "ember-launcher",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "tauri dev",
    "package": "tauri build",
    "engine:build": "python tools/build_engine.py",
    "format": "prettier --write src vite.config.js",
    "test:engine": "cargo test --locked --manifest-path engine/rust/Cargo.toml -- --test-threads=1 && uv run --project tests/oracles python tools/build_oracles.py && uv run --project tests/oracles python tools/run_checks.py",
    "portable": "npm run engine:build && tauri build --bundles deb && python tools/package_portable.py",
    "test:ui": "node --experimental-strip-types --test tests/test_news_content.ts tests/test_i18n.ts tests/test_i18n_ui.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.468.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vite": "^6"
  }
}
